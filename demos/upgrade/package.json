{
  "name": "demo-upgrade",
  "version": "0.12.0",
  "private": true,
  "scripts": {
    "build": "harsta compile --clean",
    "deploy": "harsta deploy --network hardhat --verify",
    "test": "harsta test --network hardhat",
    "verify": "harsta verify --network geneva --target ERC20WithTransparent",
    "update:transparent": "harsta update --network geneva ERC20WithTransparent --target ERC20WithTransparentV2",
    "update:uups": "harsta update --network geneva ERC20WithUUPS --target ERC20WithUUPSV2"
  },
  "dependencies": {
    "@harsta/client": "workspace:^",
    "@openzeppelin/contracts": "^5.3.0",
    "@openzeppelin/contracts-upgradeable": "^5.3.0",
    "ethers": "^6.13.5"
  },
  "devDependencies": {
    "dotenv": "^16.5.0",
    "harsta": "workspace:^"
  }
}
