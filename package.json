{
  "name": "harsta-monorepo",
  "type": "module",
  "version": "0.10.5",
  "private": true,
  "packageManager": "pnpm@10.5.2",
  "description": "TODO",
  "license": "MIT",
  "keywords": [
    "ethereum",
    "contract",
    "ethers"
  ],
  "scripts": {
    "build": "pnpm -r --filter=./packages/** --parallel build",
    "build:demo": "pnpm --filter=./demos/upgrade --parallel run build",
    "release": "bumpp -r",
    "dev": "pnpm -r --filter=./packages/** --parallel run dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit --skipLibCheck"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^2.27.3",
    "@types/node": "^20.17.23",
    "bumpp": "^9.11.1",
    "eslint": "^9.21.0",
    "vitest": "^3.0.9"
  }
}
