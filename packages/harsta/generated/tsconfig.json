{
  "compilerOptions": {
    "target": "es2020",
    "rootDir": ".",
    "module": "commonjs",
    "resolveJsonModule": true,
    "strict": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": [
    "**/*.ts"
  ],
  "exclude": [
    "tsup.config.ts"
  ]
}
