    "update:uups": "harsta update --network hardhat ERC20WithUUPS --target ERC20WithUUPSV2"
  },
  "dependencies": {
    "@chainlink/contracts": "^1.3.0",
    "@harsta/client": "workspace:^",
    "@openzeppelin/contracts": "^5.0.2",
    "@openzeppelin/contracts-upgradeable": "^5.0.2",
    "ethers": "^6.13.1"
  },
  "devDependencies": {
    "harsta": "workspace:^"
  }
}
